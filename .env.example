# ==============================================================================
# Bank Data AI - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit your real .env file into version control.
# ==============================================================================

# Database Connection (MySQL)
# Standard SQLAlchemy MySQL URL format:
# mysql+pymysql://<db_user>:<db_password>@<db_host>:<db_port>/<database_name>
DATABASE_URL=mysql+pymysql://root:your_password_here@localhost:3306/banking_risk_analytics

# LLM Configuration
# Supports Google Gemini, OpenAI, Anthropic Claude, or OpenAI-compatible endpoints
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash

# Optional Custom Endpoint (for local Ollama, vLLM, OpenRouter, Groq, etc.)
# LLM_BASE_URL=https://api.openai.com/v1
